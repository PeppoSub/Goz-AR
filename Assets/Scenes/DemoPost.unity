    m_PersistentCalls:
      m_Calls: []
  m_text: "Goz-AR is an Augmenter Reality game demo, developed in Unity with AR-Core
    for Android.\n\n....\n\nContent\tThis is a reference to the Rect Transform of
    the UI element to be scrolled, for example a large image.\r\n\nHorizontal\tEnables
    horizontal scrolling\r\nVertical\tEnables vertical scrolling\r\nMovement Type\tUnrestricted,
    Elastic or Clamped. Use Elastic or Clamped to force the content to remain within
    the bounds of the Scroll Rect. Elastic mode bounces the content when it reaches
    the edge of the Scroll Rect\r\n        Elasticity\tThis is the amount of bounce
    used in the elasticity mode.\r\nInertia\tWhen Inertia is set the content will
    continue to move when the pointer is released after a drag. When Inertia is not
    set the content will only move when dragged.\r\n        Deceleration Rate\tWhen
    Inertia is set the deceleration rate determines how quickly the contents stop
    moving. A rate of 0 will stop the movement immediately. A value of 1 means the
    movement will never slow down.\r\nScroll Sensitivity\tThe sensitivity to scroll
    wheel and track pad scroll events.\r\nViewport\tReference to the viewport Rect
    Transform that is the parent of the content Rect Transform.\r\nHorizontal Scrollbar\tOptional
    reference to a horizontal scrollbar element.\r\n        Visibility\tWhether the
    scrollbar should automatically be hidden when it isn't needed, and optionally
    expand the viewport as well.\r\n        Spacing\tThe space between the scrollbar
    and the viewport.\r\nVertical Scrollbar\tOptional reference to a vertical scrollbar
    element.\r\n        Visibility\tWhether the scrollbar should automatically be
    hidden when it isn't needed, and optionally expand the viewport as well.\r\n       
    Spacing\tThe space between the scrollbar and the viewport.\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
